                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Jadwal sesuai tanggal layanan\", function () {",
                  "    const schedules = pm.response.json();",
                  "    pm.expect(schedules.date).to.equal(pm.collectionVariables.get(\"registrationDate\"));",
                  "    pm.expect(schedules.items.length).to.be.at.least(1);",
                  "});"
                ]
