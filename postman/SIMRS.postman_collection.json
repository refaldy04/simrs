                  "});",
                  "pm.test(\"Antrean dan poli tersedia\", function () {",
                  "    const queue = pm.response.json();",
                  "    pm.expect(queue.total).to.be.at.least(1);",
                  "    pm.expect(queue.clinics).to.be.an(\"array\");",
                  "    for (const visit of queue.items) pm.expect(visit.queue_number).to.be.above(0);",
                  "});"
                ]
