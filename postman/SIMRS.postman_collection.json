            "method": "GET",
            "url": "{{backendUrl}}/registration/patients/{{registrationPatientId}}/visits"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Riwayat sesuai pasien\", function () {",
