{
  "info": {
    "name": "SIMRS",
    "description": "Pengujian REST API SIMRS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "backendUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "servicesUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "demoUsername",
      "value": "demo.dokter.umum"
    },
    {
      "key": "demoPassword",
      "value": "SimrsDemo2026!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "masterPatientId",
      "value": ""
    },
    {
      "key": "registrationDate",
      "value": "2026-11-23"
    },
    {
      "key": "registrationPatientId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Yii2 dan PostgreSQL",
      "request": {
        "method": "GET",
        "url": "{{backendUrl}}/health"
      }
    },
    {
      "name": "Health Node.js",
      "request": {
        "method": "GET",
        "url": "{{servicesUrl}}/health"
      }
    },
    {
      "name": "Autentikasi dan Akses",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Profil tanpa token",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/auth/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login dokter demo",
          "request": {
            "method": "POST",
            "url": "{{backendUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{demoUsername}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.unset(\"accessToken\");",
                  "if (pm.response.code === 200) {",
                  "    const session = pm.response.json();",
                  "    pm.test(\"Peran dokter\", function () {",
                  "        pm.expect(session.user.role_code).to.equal(\"doctor\");",
                  "        pm.expect(session.access_token).to.match(/^[0-9a-f]{64}$/);",
                  "    });",
                  "    pm.collectionVariables.set(\"accessToken\", session.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Profil dengan token",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Izin hasil lab\", function () {",
                  "    pm.expect(pm.response.json().permissions).to.include(\"lab.results.read\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Izin hasil lab di Yii2",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/auth/access?permission=lab.results.read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Tolak izin tagihan di Yii2",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/auth/access?permission=billing.manage"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Izin hasil lab di Node.js",
          "request": {
            "method": "GET",
            "url": "{{servicesUrl}}/access/laboratory"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Tolak izin dashboard di Node.js",
          "request": {
            "method": "GET",
            "url": "{{servicesUrl}}/access/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{backendUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Profil setelah token dicabut",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.collectionVariables.unset(\"accessToken\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Master Data",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login admin master data",
          "request": {
            "method": "POST",
            "url": "{{backendUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo.admin\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.unset(\"accessToken\");",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"accessToken\", pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Katalog master data",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/master-data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Delapan jenis master\", function () {",
                  "    pm.expect(pm.response.json().resources).to.have.lengthOf(8);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cari pasien demo",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/master-data/patients?q=Pasien%20Demo&status=active&page_size=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.unset(\"masterPatientId\");",
                  "if (pm.response.code === 200) {",
                  "    const page = pm.response.json();",
                  "    pm.test(\"Pencarian dan pagination\", function () {",
                  "        pm.expect(page.total).to.be.at.least(1);",
                  "        pm.expect(page.items.length).to.be.within(1, 2);",
                  "    });",
                  "    if (page.items.length) pm.collectionVariables.set(\"masterPatientId\", page.items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Detail pasien",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/master-data/patients/{{masterPatientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Detail sesuai ID\", function () {",
                  "    pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get(\"masterPatientId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Pilihan jadwal praktik",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/master-data/doctor-schedules/options"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Pilihan dokter dan poli\", function () {",
                  "    const options = pm.response.json().options;",
                  "    pm.expect(options.doctor_id).to.be.an(\"array\");",
                  "    pm.expect(options.clinic_id).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout master data",
          "request": {
            "method": "POST",
            "url": "{{backendUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "pm.collectionVariables.unset(\"accessToken\");",
                  "pm.collectionVariables.unset(\"masterPatientId\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pendaftaran dan Antrean",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login petugas pendaftaran",
          "request": {
            "method": "POST",
            "url": "{{backendUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo.pendaftaran\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.unset(\"accessToken\");",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"accessToken\", pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cari pasien untuk pendaftaran",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/registration/patients?q=DEMO-RM-005"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.unset(\"registrationPatientId\");",
                  "if (pm.response.code === 200) {",
                  "    const items = pm.response.json().items;",
                  "    pm.test(\"Pasien ditemukan dari nomor rekam medis\", function () {",
                  "        pm.expect(items[0].medical_record_no).to.equal(\"DEMO-RM-005\");",
                  "    });",
                  "    if (items.length) pm.collectionVariables.set(\"registrationPatientId\", items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Riwayat kunjungan pasien",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/registration/patients/{{registrationPatientId}}/visits"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Riwayat sesuai pasien\", function () {",
                  "    const page = pm.response.json();",
                  "    pm.expect(page.total).to.be.at.least(1);",
                  "    for (const visit of page.items) {",
                  "        pm.expect(visit.patient_id).to.equal(pm.collectionVariables.get(\"registrationPatientId\"));",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Jadwal praktik tanggal demo",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/registration/schedules?date={{registrationDate}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Jadwal sesuai tanggal layanan\", function () {",
                  "    const schedules = pm.response.json();",
                  "    pm.expect(schedules.date).to.equal(pm.collectionVariables.get(\"registrationDate\"));",
                  "    pm.expect(schedules.items.length).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Antrean tanggal demo",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/registration/visits?date={{registrationDate}}&page_size=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Antrean dan poli tersedia\", function () {",
                  "    const queue = pm.response.json();",
                  "    pm.expect(queue.total).to.be.at.least(1);",
                  "    pm.expect(queue.clinics).to.be.an(\"array\");",
                  "    for (const visit of queue.items) pm.expect(visit.queue_number).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout pendaftaran",
          "request": {
            "method": "POST",
            "url": "{{backendUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "pm.collectionVariables.unset(\"accessToken\");",
                  "pm.collectionVariables.unset(\"registrationPatientId\");"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
