        {
          "name": "Antrean tanggal demo",
          "request": {
            "method": "GET",
            "url": "{{backendUrl}}/registration/visits?date={{registrationDate}}&page_size=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
