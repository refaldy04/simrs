        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">birth_date</TD></TR>
      </TABLE>>];
    clinics [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cddf" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f5072"><FONT COLOR="#FFFFFF"><B>clinics</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">code</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">name</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">registration_fee</TD></TR>
      </TABLE>>];
    doctor_schedules [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cddf" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f5072"><FONT COLOR="#FFFFFF"><B>doctor_schedules</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">doctor_id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">clinic_id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">practice_date</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">starts_at</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">ends_at</TD></TR>
      </TABLE>>];
    medical_procedures [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cddf" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#3f5072"><FONT COLOR="#FFFFFF"><B>medical_procedures</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">code</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">name</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">price</TD></TR>
      </TABLE>>];
  }

  subgraph cluster_visits {
    label="Kunjungan dan pemeriksaan"; labeljust=l; labelloc=t; fontsize=14; fontcolor="#17566a";
    style="rounded,filled"; fillcolor="#eaf5f8"; color="#acd0d8"; penwidth=1.1; margin=16;
