        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">before_data</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">after_data</TD></TR>
      </TABLE>>];
  }

  clinics -> doctor_schedules [arrowtail=tee, arrowhead=crowodot]; // clinic_id
  clinics -> visit_queue_counters [arrowtail=tee, arrowhead=crowodot]; // clinic_id
  doctor_schedules -> visits [arrowtail=tee, arrowhead=crowodot]; // schedule_id, clinic_id, visit_date
  doctors -> doctor_schedules [arrowtail=tee, arrowhead=crowodot]; // doctor_id
  doctors -> examinations [arrowtail=tee, arrowhead=crowodot]; // examiner_id
  doctors -> lab_orders [arrowtail=tee, arrowhead=crowodot]; // ordered_by
  doctors -> prescriptions [arrowtail=tee, arrowhead=crowodot]; // prescribed_by
  doctors -> visit_procedures [arrowtail=tee, arrowhead=crowodot]; // performed_by
  examinations -> diagnoses [arrowtail=tee, arrowhead=crowodot]; // examination_id
  invoices -> invoice_items [arrowtail=tee, arrowhead=crowodot]; // invoice_id, visit_id
  invoices -> payments [arrowtail=tee, arrowhead=crowodot]; // invoice_id
  lab_order_items -> invoice_items [arrowtail=teeodot, arrowhead=teeodot]; // lab_order_item_id, visit_id
  lab_order_items -> lab_results [arrowtail=tee, arrowhead=teeodot]; // lab_order_item_id
  lab_orders -> integration_outbox [arrowtail=tee, arrowhead=crowodot]; // lab_order_id
  lab_orders -> lab_order_items [arrowtail=tee, arrowhead=crowodot]; // lab_order_id, visit_id
  lab_tests -> lab_order_items [arrowtail=tee, arrowhead=crowodot]; // lab_test_id
  medical_procedures -> visit_procedures [arrowtail=tee, arrowhead=crowodot]; // procedure_id
  medical_staff -> doctors [arrowtail=tee, arrowhead=teeodot]; // staff_id
  medicines -> medicine_stock_movements [arrowtail=tee, arrowhead=crowodot]; // medicine_id
  medicines -> prescription_items [arrowtail=tee, arrowhead=crowodot]; // medicine_id
  patients -> visits [arrowtail=tee, arrowhead=crowodot]; // patient_id
  prescription_items -> invoice_items [arrowtail=teeodot, arrowhead=teeodot]; // prescription_item_id, visit_id
  prescription_items -> medicine_stock_movements [arrowtail=teeodot, arrowhead=teeodot]; // prescription_item_id, medicine_id
  prescriptions -> prescription_items [arrowtail=tee, arrowhead=crowodot]; // prescription_id, visit_id
  roles -> users [arrowtail=tee, arrowhead=crowodot]; // role_code
  users -> audit_logs [arrowtail=tee, arrowhead=crowodot, constraint=false, style=dashed, color="#aebaca"]; // actor_user_id
  users -> invoices [arrowtail=tee, arrowhead=crowodot, constraint=false, style=dashed, color="#aebaca"]; // issued_by
  users -> lab_results [arrowtail=tee, arrowhead=crowodot, constraint=false, style=dashed, color="#aebaca"]; // entered_by
  users -> medical_staff [arrowtail=teeodot, arrowhead=teeodot]; // user_id
  users -> medicine_stock_movements [arrowtail=tee, arrowhead=crowodot, constraint=false, style=dashed, color="#aebaca"]; // recorded_by
  users -> payments [arrowtail=tee, arrowhead=crowodot, constraint=false, style=dashed, color="#aebaca"]; // received_by
  users -> prescriptions [arrowtail=teeodot, arrowhead=crowodot, constraint=false, style=dashed, color="#aebaca"]; // dispensed_by
  users -> visits [arrowtail=tee, arrowhead=crowodot, constraint=false, style=dashed, color="#aebaca"]; // registered_by
  visit_procedures -> invoice_items [arrowtail=teeodot, arrowhead=teeodot]; // visit_procedure_id, visit_id
  visit_queue_counters -> visits [arrowtail=tee, arrowhead=crowodot]; // clinic_id, visit_date
  visits -> audit_logs [arrowtail=tee, arrowhead=crowodot]; // visit_id
  visits -> examinations [arrowtail=tee, arrowhead=teeodot]; // visit_id
  visits -> invoices [arrowtail=tee, arrowhead=teeodot]; // visit_id
  visits -> lab_orders [arrowtail=tee, arrowhead=crowodot]; // visit_id
  visits -> prescriptions [arrowtail=tee, arrowhead=crowodot]; // visit_id
  visits -> visit_procedures [arrowtail=tee, arrowhead=crowodot]; // visit_id

  invoices -> invoice_balances [dir=forward, arrowhead=vee, style=dashed, color="#9b704e"];
  invoice_items -> invoice_balances [dir=forward, arrowhead=vee, style=dashed, color="#9b704e"];
  payments -> invoice_balances [dir=forward, arrowhead=vee, style=dashed, color="#9b704e"];
}
