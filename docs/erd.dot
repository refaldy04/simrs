        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">ordered_at</TD></TR>
      </TABLE>>];
    lab_order_items [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cec0e0" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#574373"><FONT COLOR="#FFFFFF"><B>lab_order_items</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">lab_order_id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">visit_id</TD></TR>
