        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">entered_by</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">entered_at</TD></TR>
      </TABLE>>];
    integration_outbox [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#cec0e0" BGCOLOR="#FFFFFF">
