// ERD PostgreSQL SIMRS. Render dengan dot -Tpng docs/erd.dot -o docs/erd.png.
digraph simrs {
  graph [rankdir=LR, newrank=true, splines=polyline, bgcolor="#F8FAFC", pad=0.36, nodesep=0.33, ranksep=0.85, dpi=155,
    fontname="DejaVu Sans", fontsize=23, fontcolor="#183047", labelloc=t, labeljust=l,
    label=<<B>ERD SIMRS Rawat Jalan</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="11">PostgreSQL 17 · PK kunci primer · FK kunci asing · UQ unik · Lingkaran menandai relasi opsional</FONT>>];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10, fontcolor="#20364d"];
  edge [color="#7590a7", penwidth=1.15, arrowsize=0.65, dir=both];

  subgraph cluster_access {
    label="Akses dan staf"; labeljust=l; labelloc=t; fontsize=14; fontcolor="#244568";
    style="rounded,filled"; fillcolor="#edf3fa"; color="#bdcee1"; penwidth=1.1; margin=16;
    roles [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#bdcee1" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#244568"><FONT COLOR="#FFFFFF"><B>roles</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">code</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">name</TD></TR>
      </TABLE>>];
    users [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#bdcee1" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#244568"><FONT COLOR="#FFFFFF"><B>users</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">role_code</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">username</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">password_hash</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">is_active</TD></TR>
      </TABLE>>];
    medical_staff [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#bdcee1" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#244568"><FONT COLOR="#FFFFFF"><B>medical_staff</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>FK/UQ</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">employee_no</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">full_name</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">profession</TD></TR>
      </TABLE>>];
    doctors [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#bdcee1" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#244568"><FONT COLOR="#FFFFFF"><B>doctors</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>PK/FK</B></FONT></TD><TD ALIGN="LEFT">staff_id</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT">specialty</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#4D6480" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">practice_license_no</TD></TR>
      </TABLE>>];
  }

  subgraph cluster_master {
    label="Master data"; labeljust=l; labelloc=t; fontsize=14; fontcolor="#3f5072";
    style="rounded,filled"; fillcolor="#eef2f8"; color="#c3cddf"; penwidth=1.1; margin=16;
    patients [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#c3cddf" BGCOLOR="#FFFFFF">
